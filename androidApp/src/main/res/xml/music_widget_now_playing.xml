<?xml version="1.0" encoding="utf-8"?>
<!-- Music fork (MUSIC.md). updatePeriodMillis is Android's floor (30 min): a self-heal for a widget that went
     stale while the app process was frozen; live changes are pushed by SurfaceHub, not polled. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/music_widget_now_playing_description"
    android:initialLayout="@layout/music_widget_np_card"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="56dp"
    android:previewLayout="@layout/music_widget_np_card"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
